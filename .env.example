# ==========================================
# ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================

# 1. Server Port
PORT=5000

# 2. Database Connection
# Optional: Set to your Supabase or PostgreSQL connection string
# Example: postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres
# If left empty, the application seamlessly uses local persistent JSON storage in data/database.json
DATABASE_URL=
DATABASE_SSL=false

# 3. AI Service Configuration
# Provider: 'gemini' (default) or 'mock'
AI_PROVIDER=gemini
# Get a free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=

# 4. Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_hackathon_2026
